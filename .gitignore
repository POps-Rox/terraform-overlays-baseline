# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data, such as
# password, private keys, and other secrets. These should not be part of version
# control as they are data points which are potentially sensitive and subject
# to change depending on the environment.
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include override files you do wish to add to version control using negated pattern
# !example_override.tf

# Include tfplan files to ignore the plan output of command: terraform plan -out=tfplan
# example: *tfplan*

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore private key files
*.key

# Ignore Certifificate Signing Request files
*.csr

# Ignore Security Certificate files
*.crt

# Ignore files in root of repo that will most likely be created during the "Get started with Terraform" section
/main.tf
/.terraform
/.terraform.lock.hcl
/tfplan

# Ignore Python virtual environment files
venv

# ---------------------------------------------------------------------------
# Secrets & local configuration — never commit these to a public repository.
# Added org-wide 2026-09. See POps-Rox/.github#1
# ---------------------------------------------------------------------------

# Kubernetes / cluster credentials
kubeconfig
kubeconfig.*
*.kubeconfig
.kube/

# Private keys, certificates & keystores
*.key
*.pem
*.pfx
*.p12
*.jks
*.keystore
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
*.ppk

# Terraform state & local workspace (state frequently embeds secrets)
*.tfstate
*.tfstate.*
*.tfstate.backup
.terraform/
.terraform.lock.hcl.local
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Environment & local app configuration
.env
.env.*
!.env.example
!.env.*.example
local.settings.json
appsettings.Local.json
secrets.json

# Cloud CLI / credential caches
.azure/
.aws/
.gcloud/
azurecreds.conf

# Dependencies & build output
node_modules/
__pycache__/
*.py[cod]
.venv/
venv/
Lib/site-packages/
pyvenv.cfg

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
*~
